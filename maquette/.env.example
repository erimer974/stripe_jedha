# Copier en .env avant de lancer docker compose (ne jamais committer .env).
# Les mots de passe apparaissent dans des URI de connexion : lettres, chiffres, _ et - uniquement.

# Administrateur des deux instances PostgreSQL (initialisation uniquement, jamais utilisé par le pipeline)
PG_ADMIN_USER=stripe_admin
PG_ADMIN_PASSWORD=change_me_local_demo

# Administrateur MongoDB (initialisation uniquement)
MONGO_ROOT_USER=mongo_admin
MONGO_ROOT_PASSWORD=change_me_local_demo

# Mot de passe des rôles de service (payment_service, el_reader, loader, transformer, ml_scorer...).
# Simplification de maquette : un secret commun. Cible : un secret par rôle, dans un coffre (Vault / Secrets Manager).
SERVICE_PASSWORD=change_me_local_demo

# Interface Airflow
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# Débit du simulateur applicatif : SIMULATOR_BATCH_SIZE transactions toutes les SIMULATOR_INTERVAL_SECONDS secondes
SIMULATOR_INTERVAL_SECONDS=30
SIMULATOR_BATCH_SIZE=20
